   return jsDay === 0 ? 6 : jsDay - 1
 }
+
+// ---- Helpers cho nhắc lịch / đếm ngược / .ics (hàm thuần, test được) ----
+
+/** "6:30" -> số phút từ 0h. */
+export function minutesOf(timeStr) {
+  const [h, m] = timeStr.split(':').map(Number)
