+                    )}
+                  </span>
+                </span>
+                <button onClick={() => { if (confirm(`Xóa task "${t.title}"?`)) onDelete(t.id) }} className="text-xs font-bold text-red-600">Xóa</button>
+              </li>
+            )
+          })}
+        </ul>
+      )}
+    </section>
+  )
+}
