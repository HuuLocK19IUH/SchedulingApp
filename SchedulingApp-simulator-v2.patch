+
+  const sessions = activePlan?.sessions || []
+  const conflicts = useMemo(() => conflictIds(sessions), [sessions])
+  const pairs = useMemo(() => conflictPairs(sessions), [sessions])
+  const score = useMemo(() => scorePlan(sessions), [sessions])
