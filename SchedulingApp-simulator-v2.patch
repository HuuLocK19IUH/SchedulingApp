+            className={`rounded-xl border px-4 py-2 text-sm font-bold ${p.id === activePlanId ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-300 bg-white hover:bg-slate-50'}`}
+          >
+            {p.name} · {scorePlan(p.sessions).score}đ
+          </button>
+        ))}
