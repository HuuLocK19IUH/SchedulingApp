@@ -3,42 +3,146 @@
 /* Dark mode theo class .dark trên <html> (hook useTheme gắn/gỡ class này). */
 @custom-variant dark (&:where(.dark, .dark *));
 
+/*
+ * Design tokens — Part 6 (Bento Grid + Soft UI Evolution).
+ * Một màu nhấn duy nhất (indigo), không dùng gradient tím/hồng neon.
+ * Token ngữ nghĩa: background / surface / foreground / primary / border / ring.
+ * Giá trị sáng ở :root, giá trị tối ở .dark — mọi mặt chính dùng token
+ * (bg-surface, border-border, text-foreground, bg-primary...) thay vì
+ * hard-code slate/white rải rác.
+ */
+:root {
+  --surface: #ffffff;
+  --background: #f6f7fb;
+  --foreground: #111827;
+  --muted: #64748b;
+  --primary: #4f46e5;
+  --primary-hover: #4338ca;
+  --border: #e2e8f0;
+  --ring: #4f46e5;
+  --shadow-card: 0 1px 2px rgb(15 23 42 / 0.05), 0 4px 16px -4px rgb(15 23 42 / 0.08);
+  --shadow-card-hover: 0 2px 4px rgb(15 23 42 / 0.06), 0 10px 28px -6px rgb(15 23 42 / 0.14);
+}
+
+.dark {
+  --surface: #0f172a;
+  --background: #0f172a;
+  --foreground: #f1f5f9;
+  --muted: #94a3b8;
+  --primary: #6366f1;
+  --primary-hover: #818cf8;
+  --border: #334155;
+  --ring: #818cf8;
+  --shadow-card: 0 1px 2px rgb(0 0 0 / 0.3), 0 4px 16px -4px rgb(0 0 0 / 0.4);
+  --shadow-card-hover: 0 2px 4px rgb(0 0 0 / 0.35), 0 10px 28px -6px rgb(0 0 0 / 0.5);
+}
+
+@theme inline {
+  --color-surface: var(--surface);
+  --color-background: var(--background);
+  --color-foreground: var(--foreground);
+  --color-muted: var(--muted);
+  --color-primary: var(--primary);
+  --color-primary-hover: var(--primary-hover);
+  --color-border: var(--border);
+  --color-ring: var(--ring);
+  --shadow-card: var(--shadow-card);
+  --shadow-card-hover: var(--shadow-card-hover);
+}
+
 body {
   font-family: "Be Vietnam Pro", system-ui, -apple-system, "Segoe UI", sans-serif;
-  background: #f6f7fb;
